# Exercise media downloaded by installs before v1.4.0 (now in catalogue/media); kept ignored so an
# old folder never gets committed by accident
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config
.env

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/
.superpowers/

# Nix build result symlinks
result
result-*

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
frontend/bundle-size.json

# Personal bridge working outputs
bridge/out/

# Personal bridge source data: the live Technogym database, the gym export,
# Wii Fit dumps and Health Connect CSVs. Copied across by the migration bundle,
# never committed.
bridge/data/

# Python bytecode from the bridge converters (personal Python, not upstream's)
__pycache__/
*.pyc

# Local planning notes
docs/superpowers/plans/
