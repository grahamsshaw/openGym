# Personal bridge runner (the pull button's other half). Copy to
# bridge/.env and fill in — that file stays out of git (see .gitignore).
#
# Everything the bridge needs is here now: it no longer reads the old Flask
# project for anything. Technogym's login happens in technogym_fetch.py.
BRIDGE_DIR=/bridge
BRIDGE_DATA_DIR=/bridge/data
DATA_DIR=/data
OG_URL=http://host.docker.internal:8080
OG_USER=Grahahsshaw
OG_PASS=put-your-openGym-password-here

# Technogym cloud login (core.mywellness.com), same account as the gym app.
MYWELLNESS_EMAIL=you@example.com
MYWELLNESS_PASSWORD=put-your-MyWellness-password-here

POLL_SECONDS=60
FULL_EVERY_HOURS=20