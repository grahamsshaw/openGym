# Personal bridge runner (the pull button's other half). Copy to
# bridge/.env and fill in — that file stays out of git (see .gitignore).
# The Flask Technogym login lives in the Flask project's own .env already.
FLASK_DIR=/flask
BRIDGE_DIR=/bridge
DATA_DIR=/data
OG_URL=http://host.docker.internal:8080
OG_USER=Grahahsshaw
OG_PASS=put-your-openGym-password-here
POLL_SECONDS=60
FULL_EVERY_HOURS=20
